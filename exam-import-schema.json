{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NHN exam import schema",
  "type": "object",
  "required": ["exam", "questions"],
  "properties": {
    "exam": {
      "type": "object",
      "required": ["code", "title", "group_key", "duration_minutes"],
      "properties": {
        "code": {"type":"string"},
        "title": {"type":"string"},
        "group_key": {"enum":["hsk","advanced","high","communication","listening","hskk","csca"]},
        "level": {"type":"string"},
        "duration_minutes": {"type":"integer","minimum":1},
        "require_explanation": {"type":"boolean"}
      }
    },
    "questions": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["content", "options"],
        "properties": {
          "type": {"type":"string"},
          "content": {"type":"string"},
          "explanation": {"type":"string"},
          "audio_key": {"type":["string","null"]},
          "image_key": {"type":["string","null"]},
          "requires_audio": {"type":"boolean"},
          "points": {"type":"number","minimum":0},
          "options": {"type":"array","minItems":2}
        }
      }
    }
  }
}
